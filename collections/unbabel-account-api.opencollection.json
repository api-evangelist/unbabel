{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unbabel Translation Account API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.unbabel.com/tapi/v2/account/"
          },
          "docs": "Retrieves the authenticated customer account's information and balance."
        }
      ]
    }
  ],
  "bundled": true
}